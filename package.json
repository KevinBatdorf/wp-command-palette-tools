{
	"name": "wpcp-tools",
	"version": "0.1.0",
	"type": "module",
	"description": "A collection of productivity tools for the WordPress Command Palette",
	"author": "Kevin Batdorf",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "tsc && biome check && wp-scripts build",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"start:hot": "wp-scripts start --hot",
		"test:e2e": "node scripts/run-e2e.mjs",
		"test:e2e:ui": "npx playwright test --ui"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@playwright/test": "^1.62.1",
		"@types/canvas-confetti": "^1.9.0",
		"@types/wordpress__block-editor": "^15.0.6",
		"@types/wordpress__edit-post": "^8.4.2",
		"@wordpress/e2e-test-utils-playwright": "^1.52.0",
		"@wordpress/scripts": "^34.0.0",
		"@wp-playground/cli": "^3.1.48",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@wordpress/block-editor": "^16.1.0",
		"@wordpress/blocks": "^15.25.0",
		"@wordpress/commands": "^1.52.0",
		"@wordpress/edit-post": "^8.52.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/i18n": "^6.25.0",
		"@wordpress/icons": "^15.3.0",
		"@wordpress/plugins": "^7.52.0",
		"canvas-confetti": "^1.9.4",
		"colord": "^2.9.3",
		"copy-to-clipboard": "^4.0.2",
		"mathjs": "^15.2.0",
		"postcss": "^8.5.25",
		"postcss-prefix-selector": "^2.1.1",
		"tailwindcss": "^4.3.3"
	}
}
